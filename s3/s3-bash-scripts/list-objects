#!/usr/bin/env bash

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
set -a
source "${SCRIPT_DIR}/../.env"
set +a

if [ -z "${1:-}" ]; then
    echo "Usage: $0 <bucket-name> [prefix]"
    exit 1
fi

prefix="${2:-}"
aws s3 ls "s3://${1}/${prefix}" --recursive --human-readable --summarize