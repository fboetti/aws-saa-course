#!/usr/bin/env bash

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
set -a
source "${SCRIPT_DIR}/../.env"
set +a

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 <bucket-name> <local-file> [s3-key]"
    exit 1
fi

bucket="$1"
file="$2"
key="${3:-$(basename "$file")}"

aws s3 cp "$file" "s3://${bucket}/${key}"
echo "Uploaded ${file} to s3://${bucket}/${key}"