#!/usr/bin/env bash

set -euo pipefail

# Install the AWS CLI v2 into the Gitpod workspace if it is not already present.
cd /workspace

if command -v aws >/dev/null 2>&1; then
  echo "AWS CLI already installed: $(aws --version)"
else
  rm -f /workspace/awscliv2.zip
  rm -rf /workspace/aws
  curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /workspace/awscliv2.zip
  unzip -o /workspace/awscliv2.zip -d /workspace >/dev/null
  sudo /workspace/aws/install
fi

# Verify the account only when credentials were provided through Gitpod env vars.
# AWS CLI reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION automatically.
if [[ -n "${AWS_ACCESS_KEY_ID:-}" && -n "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
  echo "Verifying AWS credentials..."
  aws sts get-caller-identity
else
  echo "AWS credentials are not set yet. See README.md -> 'AWS credentials in Gitpod'."
fi

cd "${GITPOD_REPO_ROOT:-/workspace/aws-saa-course}"
