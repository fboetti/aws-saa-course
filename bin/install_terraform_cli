#!/usr/bin/env bash

set -euo pipefail

# Install HashiCorp Terraform on the Gitpod (Ubuntu/Debian) workspace.
cd /workspace

if command -v terraform >/dev/null 2>&1; then
  echo "Terraform already installed: $(terraform version | head -n 1)"
else
  sudo apt-get update
  sudo apt-get install -y gnupg software-properties-common curl wget lsb-release

  wget -O- https://apt.releases.hashicorp.com/gpg | \
    gpg --dearmor | sudo tee /usr/share/keyrings/hashicorp-archive-keyring.gpg >/dev/null

  echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] \
  https://apt.releases.hashicorp.com $(lsb_release -cs) main" | \
    sudo tee /etc/apt/sources.list.d/hashicorp.list

  sudo apt-get update
  sudo apt-get install -y terraform
fi

terraform version
cd "${GITPOD_REPO_ROOT:-/workspace/aws-saa-course}"
